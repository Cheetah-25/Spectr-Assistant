diff --git a/spectro/verify.py b/spectro/verify.py
index 5da49ee..25103f8 100644
--- a/spectro/verify.py
+++ b/spectro/verify.py
@@ -211,6 +211,34 @@ def _iter_citations(assessment: dict):
             yield f"measurement_concept.citations[{j}]", cit
 
 
+
+MAX_QUOTE_CHARS = 160
+
+
+def prune_unverifiable_quotes(assessment: dict, kb: KnowledgeBase) -> List[str]:
+    """Remove citation quotes that are too long or not verbatim on the cited page.
+
+    The citation itself (source and page) is kept; only the unverifiable quote is dropped, and each
+    removal is returned as a note so it stays visible in meta.verification.warnings.
+    """
+    notes: List[str] = []
+    if not isinstance(assessment, dict):
+        return notes
+    for loc, cit in _iter_citations(assessment):
+        quote = cit.get("quote")
+        if not quote or not isinstance(quote, str):
+            continue
+        src, page = cit.get("source_id"), cit.get("page")
+        too_long = len(quote) > MAX_QUOTE_CHARS
+        page_text = normalize_ws(kb.page_text(src, page) or "").lower() if kb.pages_for(src) else ""
+        missing = normalize_ws(quote).lower() not in page_text
+        if too_long or missing:
+            cit.pop("quote", None)
+            reason = "longer than 160 characters" if too_long else "not verbatim on the cited page"
+            notes.append(f"{loc}: quote removed ({reason}); citation kept at {src} p.{page}")
+    return notes
+
+
 def check_citations(assessment: dict, kb: KnowledgeBase) -> Tuple[bool, List[str]]:
     warnings: List[str] = []
     ok = True
diff --git a/tests/test_status_guidance.py b/tests/test_status_guidance.py
index 5d68710..c98b4d5 100644
--- a/tests/test_status_guidance.py
+++ b/tests/test_status_guidance.py
@@ -31,3 +31,23 @@ def test_consistent_cases_do_not_warn():
 
 def test_prompt_contains_status_guidance():
     assert "Default to provisional_assessment" in prompts.ASSESS_SYSTEM
+
+
+def test_prune_removes_long_and_unverifiable_quotes(tiny_kb):
+    src = next(iter(tiny_kb.sources()))
+    page = sorted(tiny_kb.pages_for(src))[0]
+    real = " ".join(tiny_kb.page_text(src, page).split()[:4])
+    a = {
+        "recommendations": [
+            {"citations": [
+                {"source_id": src, "page": page, "quote": real, "supports": "x"},
+                {"source_id": src, "page": page, "quote": "definitely not on this page", "supports": "x"},
+                {"source_id": src, "page": page, "quote": real + " " + "word " * 60, "supports": "x"},
+            ]}
+        ]
+    }
+    notes = verify.prune_unverifiable_quotes(a, tiny_kb)
+    cits = a["recommendations"][0]["citations"]
+    assert cits[0].get("quote") == real
+    assert "quote" not in cits[1] and "quote" not in cits[2]
+    assert len(notes) == 2
